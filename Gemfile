source "https://rubygems.org"

# Mirrors the classic GitHub Pages build (Jekyll 3.10 + whitelisted plugins),
# so `bundle exec jekyll serve` renders exactly what production renders.
gem "github-pages", group: :jekyll_plugins

# Removed from Ruby's default gems in 3.4; needed only for local builds.
gem "base64"
gem "bigdecimal"
gem "csv"
gem "logger"
gem "webrick"
